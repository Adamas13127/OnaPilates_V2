<!doctype html>
<html lang="fr" class="smooth-scroll">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {{ content_for_header }}
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      :root {
        --accent-start: {{ settings.accent_start }};
        --accent-end: {{ settings.accent_end }};
      }
    </style>
    <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">
  </head>
  <body class="bg-white text-slate-900">
    <div class="loader"><span>OnePilates</span></div>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main>
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% section 'popup' %}

    <script src="{{ 'script.js' | asset_url }}"></script>
  </body>
</html>
