<section class="pt-32 pb-16">
  <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
    <div class="relative">
      <div class="absolute inset-0 rounded-[36px] bg-gradient-to-br from-pink-100 via-white to-purple-100"></div>
      <div class="relative z-10 rounded-[36px] bg-white p-8 shadow-2xl">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 900 }}"
            alt="{{ product.title }}"
            class="w-full rounded-3xl object-cover"
          >
        {% else %}
          <div class="rounded-3xl bg-purple-50 p-10 text-center text-slate-500">Ajoutez une image produit.</div>
        {% endif %}
      </div>
    </div>
    <div class="space-y-6">
      <span class="inline-flex items-center gap-2 rounded-full bg-purple-50 px-4 py-2 text-sm text-purple-700">
        {{ section.settings.badge_text }}
      </span>
      <h1 class="text-4xl font-bold">
        {{ product.title }}
      </h1>
      <p class="text-slate-600">{{ product.description | strip_html | truncate: 220 }}</p>
      <div class="text-3xl font-bold text-slate-900">{{ product.price | money }}</div>
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button
          type="submit"
          class="rounded-full bg-gradient-to-r from-pink-400 to-purple-500 px-6 py-3 text-white font-semibold shadow-lg"
        >
          {{ section.settings.add_to_cart_label }}
        </button>
      {% endform %}
      <div class="flex flex-wrap gap-3">
        {% for block in section.blocks %}
          <span class="rounded-full bg-pink-100 px-4 py-2 text-sm text-purple-700">{{ block.settings.label }}</span>
        {% endfor %}
      </div>
      <div class="mt-6 grid gap-3 text-slate-600">
        <div class="flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-pink-400"></span>
          {{ section.settings.detail_one }}
        </div>
        <div class="flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-purple-400"></span>
          {{ section.settings.detail_two }}
        </div>
        <div class="flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-pink-400"></span>
          {{ section.settings.detail_three }}
        </div>
      </div>
      <a href="/checkout" class="inline-flex items-center gap-2 text-purple-700 font-semibold">Aller au paiement →</a>
    </div>
  </div>
</section>

<section class="py-16">
  <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-10">
    <div class="rounded-3xl border border-purple-100 p-8">
      <h3 class="text-2xl font-semibold">{{ section.settings.specs_title }}</h3>
      <ul class="mt-6 space-y-3 text-slate-600">
        {% for block in section.blocks %}
          {% if block.type == 'spec' %}
            <li>{{ block.settings.spec }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
    <div class="rounded-3xl border border-purple-100 p-8">
      <h3 class="text-2xl font-semibold">{{ section.settings.feel_title }}</h3>
      <ul class="mt-6 space-y-3 text-slate-600">
        {% for block in section.blocks %}
          {% if block.type == 'feel' %}
            <li>{{ block.settings.feel }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="py-16 bg-gradient-to-b from-white to-purple-50">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center">
      <h2 class="text-3xl font-bold gradient-text">{{ section.settings.coaching_title }}</h2>
      <p class="mt-4 text-slate-600 max-w-2xl mx-auto">{{ section.settings.coaching_text }}</p>
    </div>
    <div class="mt-12 grid md:grid-cols-3 gap-6">
      {% for block in section.blocks %}
        {% if block.type == 'support' %}
          <div class="rounded-3xl bg-white p-6 shadow-lg">
            <h3 class="text-xl font-semibold">{{ block.settings.title }}</h3>
            <p class="mt-3 text-slate-600">{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="py-16">
  <div class="max-w-5xl mx-auto px-4 text-center">
    <h2 class="text-3xl font-bold gradient-text">{{ section.settings.cta_title }}</h2>
    <p class="mt-4 text-slate-600">{{ section.settings.cta_text }}</p>
    <div class="mt-8 flex justify-center gap-4">
      <a
        href="/checkout"
        class="rounded-full bg-gradient-to-r from-pink-400 to-purple-500 px-8 py-3 text-white font-semibold"
      >
        {{ section.settings.cta_button }}
      </a>
      <a href="/" class="rounded-full border border-purple-200 px-8 py-3 font-semibold text-purple-700">
        {{ section.settings.back_button }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge",
      "default": "Détails produit premium"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Label bouton",
      "default": "Ajouter au panier"
    },
    {
      "type": "text",
      "id": "detail_one",
      "label": "Bénéfice 1",
      "default": "Design sculptural, pensé pour durer."
    },
    {
      "type": "text",
      "id": "detail_two",
      "label": "Bénéfice 2",
      "default": "Résistance silencieuse et fluide."
    },
    {
      "type": "text",
      "id": "detail_three",
      "label": "Bénéfice 3",
      "default": "Coaching vidéo inclus 12 semaines."
    },
    {
      "type": "text",
      "id": "specs_title",
      "label": "Titre specs",
      "default": "Spécifications techniques"
    },
    {
      "type": "text",
      "id": "feel_title",
      "label": "Titre ressentis",
      "default": "Ce que vous ressentez"
    },
    {
      "type": "text",
      "id": "coaching_title",
      "label": "Titre accompagnement",
      "default": "Un accompagnement complet"
    },
    {
      "type": "textarea",
      "id": "coaching_text",
      "label": "Texte accompagnement",
      "default": "En plus du reformer, profitez d'un parcours guidé : vidéo onboarding, planning hebdo et support expert."
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "Titre CTA",
      "default": "Prête à transformer votre quotidien ?"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "Texte CTA",
      "default": "Offrez-vous l'expérience pilates la plus premium du marché."
    },
    {
      "type": "text",
      "id": "cta_button",
      "label": "Bouton CTA",
      "default": "Commander le reformer"
    },
    {
      "type": "text",
      "id": "back_button",
      "label": "Bouton retour",
      "default": "Retour accueil"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge produit",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Badge",
          "default": "Coaching vidéo inclus"
        }
      ]
    },
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        {
          "type": "text",
          "id": "spec",
          "label": "Spec",
          "default": "Dimensions : 230 cm x 70 cm"
        }
      ]
    },
    {
      "type": "feel",
      "name": "Ressenti",
      "settings": [
        {
          "type": "text",
          "id": "feel",
          "label": "Ressenti",
          "default": "Gainage profond et posture élégante"
        }
      ]
    },
    {
      "type": "support",
      "name": "Accompagnement",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Onboarding vidéo"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte",
          "default": "Une vidéo d'installation et de prise en main pour démarrer rapidement."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main product",
      "blocks": [
        { "type": "badge" },
        { "type": "badge", "settings": { "label": "Garantie 5 ans" } },
        { "type": "spec" },
        { "type": "spec", "settings": { "spec": "Poids supporté : 150 kg" } },
        { "type": "spec", "settings": { "spec": "6 niveaux de résistance" } },
        { "type": "spec", "settings": { "spec": "Accessoires inclus : straps, box, jumpboard" } },
        { "type": "feel" },
        { "type": "feel", "settings": { "feel": "Mobilité améliorée dès 2 semaines" } },
        { "type": "feel", "settings": { "feel": "Énergie et vitalité quotidiennes" } },
        { "type": "feel", "settings": { "feel": "Rituel bien-être premium chez soi" } },
        { "type": "support" },
        { "type": "support", "settings": { "title": "Programme 12 semaines", "text": "Des séances ciblées pour tonifier, renforcer et allonger." } },
        { "type": "support", "settings": { "title": "Coach dédié", "text": "Conseils personnalisés et réponses rapides à vos questions." } }
      ]
    }
  ]
}
{% endschema %}
